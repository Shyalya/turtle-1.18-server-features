# Config keys added by these patches. Append the blocks you need to your
# mangosd.conf. Every key falls back to the default shown here if omitted,
# EXCEPT the two *.Enable switches - those default to 0, so without them the
# corresponding feature stays off entirely.

###################################################################################################
# AUTO WORLD BUFF (patch 0001)
#
#    AutoWorldBuff.Enable
#        Periodically applies world buffs to real online players (bots and the
#        Discord bridge excluded):
#          - Spirit of Zandalar               anyone in Stranglethorn Vale
#          - Warchief's Blessing              Horde only, in Crossroads or Orgrimmar
#          - Rallying Cry of the Dragonslayer Alliance in Stormwind City,
#                                             Horde in Orgrimmar
#        Each buff has its own independent timer, so they do not all fire at once.
#    AutoWorldBuff.FirstMinInterval / FirstMaxInterval (ms)
#        Range for the FIRST roll after a (re)start. Kept short so that frequent
#        restarts do not delay the buffs by a full interval every time.
#        Default 600000 (10min) - 7200000 (2h).
#    AutoWorldBuff.MinInterval / MaxInterval (ms)
#        Range for every roll after the first, i.e. while the server keeps running.
#        Default 3600000 (1h) - 10800000 (3h).
#    AutoWorldBuff.WarningInterval (ms)
#        How long before each refresh the announcement is sent. Default 600000 (10min).
#
AutoWorldBuff.Enable = 1
AutoWorldBuff.FirstMinInterval = 600000
AutoWorldBuff.FirstMaxInterval = 7200000
AutoWorldBuff.MinInterval = 3600000
AutoWorldBuff.MaxInterval = 10800000
AutoWorldBuff.WarningInterval = 600000

###################################################################################################
# AUTO DONATION POINTS (patch 0001)
#
#    Requires the `donation_point_progress` table - see sql/donation_point_progress.sql.
#
#    AutoDonationPoints.Enable
#        Grants donation points (shop_coins) to real online players (bots and the
#        Discord bridge excluded) for time spent online. Tracked per account, so
#        it does not matter when someone logs in.
#    AutoDonationPoints.IntervalMs
#        How much online time earns one payout. Default 3600000 (1h).
#    AutoDonationPoints.Amount
#        How many points per payout. Default 1.
#    AutoDonationPoints.FlushIntervalMs
#        How often accumulated progress is written to the database. Progress
#        survives restarts; at worst the last <FlushIntervalMs> is lost.
#        Default 300000 (5min).
#
AutoDonationPoints.Enable = 1
AutoDonationPoints.IntervalMs = 3600000
AutoDonationPoints.Amount = 1
AutoDonationPoints.FlushIntervalMs = 300000

###################################################################################################
# BEGINNERS GUILD (patch 0002)
#
#    BeginnersGuilds
#        Auto-joins new, guildless real players of level 5 or below into a
#        welcome guild on first login.
#    BeginnersGuildHorde / BeginnersGuildAlliance
#        guildid of the guild to join per faction. Create the guilds first
#        (e.g. in-game via .guild create) and put their ids here - a value of 0
#        or a non-existent guild id simply disables it for that faction.
#
BeginnersGuilds = 1
BeginnersGuildHorde = 0
BeginnersGuildAlliance = 0

###############################################################################
# Patch 0006 - solo dungeon quality of life
###############################################################################

# Leech already exists upstream: it heals the attacker for a share of the
# damage they deal. Unrestricted that hits every player - including every
# random bot - and applies in PvP, where a flat heal on damage skews fights.
# Each switch below is independent; turn off the ones you do not want.
#
#   PvEOnly          no healing when the victim is a player
#   RealPlayersOnly  no healing for random bots (RNDBOT accounts)
#   SoloOnly         no healing while in a party or raid
#   DungeonOnly      no healing out in the open world
#
# Note Amount is a fraction of damage dealt, so small hits heal nothing
# visible: 5% of 15 damage rounds away.

Leech.Enable = 0
Leech.Amount = 0.05
Leech.PvEOnly = 1
Leech.RealPlayersOnly = 1
Leech.SoloOnly = 1
Leech.DungeonOnly = 1

# Brings a player who dies ALONE inside an instance back alive just inside the
# entrance, instead of a corpse run nobody can shortcut for them. Does nothing
# when the player is in a group - a group can resurrect. Raids included,
# battlegrounds not (own map type).
#
# Needs the instance to have an entrance trigger in areatrigger_teleport,
# which every dungeon on this server does.

SoloDungeonRepopAlive.Enable = 0

###############################################################################
# Patch 0008 - guild bank vault keepers
###############################################################################

# Which creatures count as guild vault keepers. A player has to stand next to
# one of them for guild bank actions to be accepted. The defaults reproduce the
# old hardcoded pair - Stormwind and Orgrimmar only. Add the decorative keepers
# Turtle placed in the other capitals to make the bank work there too, and give
# them a gossip menu via sql/guildbank_trigger.sql.
#
#   62008 Faredin (Darnassus), 62009 Lorien (gnome bank), 62011 Golgan (Ironforge)
#   62010 Gewana (Thunder Bluff), 62012 Arthur (Undercity)

GuildBank.NpcEntriesAlliance = 80917,62008,62009,62011
GuildBank.NpcEntriesHorde = 80918,62010,62012

###############################################################################
# Patch 0009 - dungeon finder fills groups with bots
###############################################################################

# Bots are put into the same queue real players sit in, so the existing matcher
# handles roles, faction, hardcore mode and group building. Getting to the
# dungeon is not automated: the party leader types "summon" in party chat.
#
#   DelaySeconds  how long a real player waits before bots are added. Filling
#                 instantly would mean nobody ever waits for a human again.
#   LevelRange    bots may be this many levels above or below the waiting
#                 player. The instance names the client sends carry no level
#                 information, so the player is the reference.
#
# Real players always take priority: when one joins the queue, every bot not
# already part of an offer is dropped again.

LFT.BotFill.Enable = 0
LFT.BotFill.DelaySeconds = 90
LFT.BotFill.LevelRange = 5

###############################################################################
# Patch 0012 - premade talent specs (aiplayerbot.conf, not mangosd.conf)
###############################################################################

# The talent specs are not mangosd.conf keys. They belong in aiplayerbot.conf,
# and the patch already replaces them in aiplayerbot.conf.dist.in - a generated
# config from an older checkout keeps the broken stock links, so either
# regenerate it or copy conf/aiplayerbot.conf.premade-specs over the old
# AiPlayerbot.PremadeSpec* block by hand.
#
# Without this every one of the stock links is rejected at startup against
# Turtle's reworked trees and the bots end up with no talents at all. The log
# says "Error with premade spec link" once per link and "No premade specs
# found!!" at the end.
