 .../strategy/actions/BattleGroundTactics.cpp  | 117 +++++++++++-------
 1 file changed, 70 insertions(+), 47 deletions(-)

diff --git a/src/modules/PlayerBots/playerbot/strategy/actions/BattleGroundTactics.cpp b/src/modules/PlayerBots/playerbot/strategy/actions/BattleGroundTactics.cpp
index 3478834..bd29c95 100644
