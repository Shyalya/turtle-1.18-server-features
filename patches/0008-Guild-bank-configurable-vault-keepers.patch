From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Shyalya <shyalya@users.noreply.github.com>
Date: Thu, 30 Jul 2026 06:10:00 +0200
Subject: [PATCH 0008] Guild bank: configurable vault keepers instead of two
 hardcoded entries

GuildBank::HandleAddonMessages only accepted a player standing next to
creature 80917 (Alliance) or 80918 (Horde), so the guild bank worked in
Stormwind and Orgrimmar and nowhere else. Turtle ships decorative vault
keepers next to the banks in Darnassus, Ironforge, Undercity and Thunder
Bluff, plus one at the gnome bank, that were never wired up.

Assigning them a gossip menu alone does not help: the window would open
and every action - deposit, withdraw, switching tabs - would be dropped
silently by that proximity check. The check itself has to go.

Replaced with two config lists, one per faction, parsed once on first
use. Defaults reproduce the previous behaviour exactly, so this changes
nothing until entries are added. This is what the comment above the old
check already suggested.

Also translates the leftover German comments in the config template that
came in with patch 0006.

diff --git a/src/game/GuildBank/GuildBank.cpp b/src/game/GuildBank/GuildBank.cpp
index 77776ef..116e4fd 100644
--- a/src/game/GuildBank/GuildBank.cpp
+++ b/src/game/GuildBank/GuildBank.cpp
@@ -18,6 +18,7 @@
 
 #include "GuildBank.h"
 #include "Guild.h"
+#include "Config/Config.h"   // GuildBank.NpcEntries* - which NPCs may open the bank
 #include "World.h"
 #include "ObjectMgr.h"
 #include "ObjectGuid.h"
@@ -87,8 +88,34 @@ enum BankCommLimits
 	ADDON_MAX_PACKET_SIZE = 2096,
 };
 
-constexpr uint32 AllianceGuildNpcEntry = 80917;
-constexpr uint32 HordeGuildNpcEntry = 80918;
+// Which creature entries a player has to stand next to for guild bank actions
+// to be accepted. Configurable so extra vault keepers can be placed in other
+// cities without a rebuild - Turtle ships decorative ones in Ironforge,
+// Darnassus, Undercity and Thunder Bluff that were never wired up.
+// Parsed once on first use; defaults reproduce the previous hardcoded pair.
+static std::set<uint32> const& GetGuildBankNpcEntries(bool horde)
+{
+    static std::set<uint32> allianceEntries;
+    static std::set<uint32> hordeEntries;
+    static bool loaded = false;
+
+    if (!loaded)
+    {
+        loaded = true;
+        auto parse = [](std::string const& list, std::set<uint32>& out)
+        {
+            std::string number;
+            std::istringstream stream(list);
+            while (std::getline(stream, number, ','))
+                if (uint32 entry = uint32(atoi(number.c_str())))
+                    out.insert(entry);
+        };
+        parse(sConfig.GetStringDefault("GuildBank.NpcEntriesAlliance", "80917"), allianceEntries);
+        parse(sConfig.GetStringDefault("GuildBank.NpcEntriesHorde", "80918"), hordeEntries);
+    }
+
+    return horde ? hordeEntries : allianceEntries;
+}
 
 GuildBank::GuildBank(bool isInfenoBank)
 {
@@ -122,9 +149,17 @@ void GuildBank::HandleAddonMessages(std::string msg, Player* player)
 
 
 	//Should rather do a full search on all nearby creatures and check their flag for GOSSIP_FLAG_GUILD_BANKER but this works for now..
-	const uint32 findCreatureEntry = player->GetTeamId() == TEAM_HORDE ? HordeGuildNpcEntry : AllianceGuildNpcEntry;
+	bool nearVaultKeeper = false;
+	for (uint32 entry : GetGuildBankNpcEntries(player->GetTeamId() == TEAM_HORDE))
+	{
+		if (player->FindNearestCreature(entry, INTERACTION_DISTANCE))
+		{
+			nearVaultKeeper = true;
+			break;
+		}
+	}
 
-	if (!player->FindNearestCreature(findCreatureEntry, INTERACTION_DISTANCE))
+	if (!nearVaultKeeper)
 		return;
 
 	if (b_saveLock)
diff --git a/src/mangosd/mangosd.conf.dist.in b/src/mangosd/mangosd.conf.dist.in
index f36a706..d26ba53 100644
--- a/src/mangosd/mangosd.conf.dist.in
+++ b/src/mangosd/mangosd.conf.dist.in
@@ -2155,23 +2155,34 @@ Leech.Enable = 0
 # Sets the percentage of damage to leech
 Leech.Amount = 0.05
 
-# Leech-Eingrenzungen. Ohne diese wirkt der Leech auf jeden Spieler - also auch
-# auf die Random-Bots - und ebenso im PvP.
-#   PvEOnly          nur gegen Nicht-Spieler
-#   RealPlayersOnly  keine Random-Bots (RNDBOT-Accounts)
-#   SoloOnly         nur ohne Gruppe/Raid
+# Leech restrictions. Without them the leech applies to every player -
+# including the random bots - and in PvP as well.
+#   PvEOnly          against non-players only
+#   RealPlayersOnly  no random bots (RNDBOT accounts)
+#   SoloOnly         only while not in a party or raid
+#   DungeonOnly      instances only (dungeons and raids), not the open world
 Leech.PvEOnly = 1
 Leech.RealPlayersOnly = 1
 Leech.SoloOnly = 1
-#   DungeonOnly      nur in Instanzen (Dungeons/Raids), nicht in der offenen Welt
 Leech.DungeonOnly = 1
 
-# SoloDungeonRepopAlive. Wer ALLEIN in einer Instanz stirbt, kommt beim
-# Geist-Freilassen lebendig am Instanzeingang an statt den Leichnamslauf machen
-# zu muessen. Sobald eine Gruppe dabei ist, greift es nicht (die kann ja
-# wiederbeleben). Gilt via Map::IsDungeon() auch fuer Raids.
+# SoloDungeonRepopAlive. A player who dies ALONE inside an instance is brought
+# back alive just inside the entrance instead of having to walk their corpse
+# back - solo there is nobody who could resurrect them. Does nothing while in a
+# group, since a group can resurrect. Map::IsDungeon() covers raids too.
 SoloDungeonRepopAlive.Enable = 0
 
+# GuildBank.NpcEntries*. Which creatures count as guild vault keepers - a player
+# has to stand next to one of them for guild bank actions to be accepted.
+# Previously 80917/80918 were hardcoded, so only Stormwind and Orgrimmar worked.
+# Turtle places decorative vault keepers in the other capitals that were never
+# wired up; they are listed here.
+#   62008 Faredin (Darnassus), 62009 Lorien (gnome bank), 62011 Golgan (Ironforge)
+#   62010 Gewana (Thunder Bluff), 62012 Arthur (Undercity)
+# They also need gossip_menu_id set, see sql/guildbank_trigger.sql.
+GuildBank.NpcEntriesAlliance = 80917
+GuildBank.NpcEntriesHorde = 80918
+
 # AutoScaler.Enable. Enable or disable instance auto-scaling. 0 = off, 1 = on.
 AutoScalerEnable = 0
 
