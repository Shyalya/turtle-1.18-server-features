+void Playerbot_SetForcedRole(Player* bot, uint8 role)
+{
+    if (!bot)
+        return;
+
+    PlayerbotAI* ai = bot->GetPlayerbotAI();
+    if (!ai)
+        return;
+
+    if (ai->GetForcedRole() == role)
+        return;
+
+    ai->SetForcedRole(role);
+    ai->ResetStrategies();
+}
diff --git a/src/modules/PlayerBots/playerbot/PlayerbotAI.cpp b/src/modules/PlayerBots/playerbot/PlayerbotAI.cpp
