From 3da4b5412c725e568a49d23227fc9e37e46c2d75 Mon Sep 17 00:00:00 2001
From: shyalya <shyalya@turtle-server.local>
Date: Mon, 27 Jul 2026 11:40:29 +0100
Subject: [PATCH 04/10] Fix WSG flag carriers freezing forever when both flags
 are out

selectObjective() previously sent a flag carrier to a random 'hiding spot'
instead of home base whenever the enemy also held our own flag
(teamFlagTaken()) - a fairly common mid-match state. resetObjective()'s
'don't switch hiding spots' guard then permanently refused to ever pick a
new objective once the bot arrived there (its own comment already admits
this: 'disabled for now until hiding spots reimplemented since it causes
bots to stop moving'). The carrier would freeze in the middle of the map
forever, confirmed live.

Always heading straight for home base sidesteps this entirely: worst case
the carrier waits at its own base until our flag is returned, instead of
freezing at an arbitrary point it can never leave.
---
 .../strategy/actions/BattleGroundTactics.cpp  | 37 ++++++++-----------
 1 file changed, 15 insertions(+), 22 deletions(-)

diff --git a/src/modules/PlayerBots/playerbot/strategy/actions/BattleGroundTactics.cpp b/src/modules/PlayerBots/playerbot/strategy/actions/BattleGroundTactics.cpp
index 3478834..0fe2117 100644
--- a/src/modules/PlayerBots/playerbot/strategy/actions/BattleGroundTactics.cpp
+++ b/src/modules/PlayerBots/playerbot/strategy/actions/BattleGroundTactics.cpp
@@ -3012,30 +3012,23 @@ bool BGTactics::selectObjective(bool reset)
 
         if (bot->HasAura(BG_WS_SPELL_WARSONG_FLAG) || bot->HasAura(BG_WS_SPELL_SILVERWING_FLAG))
         {
+            // Always head straight for home base with the flag, even if the
+            // enemy also currently holds our own flag (teamFlagTaken()) -
+            // previously this sent the carrier to a random "hiding spot"
+            // instead in that case, and resetObjective()'s "don't switch
+            // hiding spots" guard (see its comment: "disabled for now until
+            // hiding spots reimplemented since it causes bots to stop
+            // moving") then permanently refused to ever re-pick a new
+            // objective once the bot arrived there - the flag carrier would
+            // freeze in the middle of the field forever, confirmed live
+            // 2026-07-27. Heading home unconditionally sidesteps that: the
+            // bot just waits at its own base (worst case) instead of
+            // freezing at an arbitrary hiding spot, and can still capture
+            // the instant our flag comes home.
             if (bot->GetTeam() == ALLIANCE)
-            {
-                if (teamFlagTaken())
-                {
-                    Position hidePos = WS_FLAG_HIDE_ALLIANCE[urand(0, 4)];
-                    pos.Set(hidePos.x, hidePos.y, hidePos.z, bot->GetMapId());
-                }
-                else
-                {
-                    pos.Set(WS_FLAG_POS_ALLIANCE.x, WS_FLAG_POS_ALLIANCE.y, WS_FLAG_POS_ALLIANCE.z, bot->GetMapId());
-                }
-            }
+                pos.Set(WS_FLAG_POS_ALLIANCE.x, WS_FLAG_POS_ALLIANCE.y, WS_FLAG_POS_ALLIANCE.z, bot->GetMapId());
             else
-            {
-                if (teamFlagTaken())
-                {
-                    Position hidePos = WS_FLAG_HIDE_HORDE[urand(0, 4)];
-                    pos.Set(hidePos.x, hidePos.y, hidePos.z, bot->GetMapId());
-                }
-                else
-                {
-                    pos.Set(WS_FLAG_POS_HORDE.x, WS_FLAG_POS_HORDE.y, WS_FLAG_POS_HORDE.z, bot->GetMapId());
-                }
-            }
+                pos.Set(WS_FLAG_POS_HORDE.x, WS_FLAG_POS_HORDE.y, WS_FLAG_POS_HORDE.z, bot->GetMapId());
         }
         else
         {
