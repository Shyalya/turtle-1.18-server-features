From 2a7e8c90fe13f9f0fb3fbdd5d16ccdb3f7e49cd7 Mon Sep 17 00:00:00 2001
From: shyalya <shyalya@turtle-server.local>
Date: Mon, 27 Jul 2026 11:48:59 +0100
Subject: [PATCH 6/7] Fix bots never fighting each other in battlegrounds

The +pvp strategy's 'enemy player near' -> 'attack enemy player' trigger
was only wired into the combat engine (InitCombatTriggers), but an idle
bot never transitions into BOT_STATE_COMBAT just because an enemy is
standing nearby - only the reactive 'was attacked' path does that. Result:
two idle enemy bots next to each other never fought, since the trigger
that would start the fight was never even checked until combat had
somehow already started (chicken-and-egg). The only thing that worked was
a human player directly attacking a bot, which flips native combat state
for that one bot.

Registers the same trigger in InitNonCombatTriggers too, and applies +pvp
to both BOT_STATE_COMBAT and BOT_STATE_NON_COMBAT on BG entry. The
attack action itself already transitions the bot into combat state once
it fires, so this is safe from the non-combat engine.
---
 .../strategy/actions/BattleGroundJoinAction.cpp      |  9 ++++++++-
 .../strategy/generic/AttackEnemyPlayersStrategy.cpp  |  7 +++++++
 .../strategy/generic/AttackEnemyPlayersStrategy.h    | 12 ++++++++++++
 3 files changed, 27 insertions(+), 1 deletion(-)

diff --git a/src/modules/PlayerBots/playerbot/strategy/actions/BattleGroundJoinAction.cpp b/src/modules/PlayerBots/playerbot/strategy/actions/BattleGroundJoinAction.cpp
index dc09558..58f12f6 100644
--- a/src/modules/PlayerBots/playerbot/strategy/actions/BattleGroundJoinAction.cpp
+++ b/src/modules/PlayerBots/playerbot/strategy/actions/BattleGroundJoinAction.cpp
@@ -1422,8 +1422,15 @@ bool BGStatusAction::Execute(Event& event)
         ai->ResetStrategies(false);
         // Bots otherwise only fight back when attacked (assist/dps strategies react to
         // an existing target) but never seek out enemy players on their own inside a BG.
-        // +pvp wires up the "enemy player near" -> "attack enemy player" trigger.
+        // +pvp wires up the "enemy player near" -> "attack enemy player" trigger. Applied
+        // to BOTH engines (2026-07-27, was combat-only): an idle bot never enters
+        // BOT_STATE_COMBAT on its own just because an enemy is nearby, so the
+        // combat-only version never actually fired between two idle bots - only a
+        // human player's attack (which flips native combat state) could ever trigger
+        // it. AttackEnemyPlayersStrategy::InitNonCombatTriggers now also registers
+        // this trigger so idle bots can proactively start a fight.
         ai->ChangeStrategy("+pvp", BotState::BOT_STATE_COMBAT);
+        ai->ChangeStrategy("+pvp", BotState::BOT_STATE_NON_COMBAT);
         context->GetValue<uint32>("bg role")->Set(urand(0, 9));
         ai::PositionMap& posMap = context->GetValue<ai::PositionMap&>("position")->Get();
         ai::PositionEntry pos = context->GetValue<ai::PositionMap&>("position")->Get()["bg objective"];
diff --git a/src/modules/PlayerBots/playerbot/strategy/generic/AttackEnemyPlayersStrategy.cpp b/src/modules/PlayerBots/playerbot/strategy/generic/AttackEnemyPlayersStrategy.cpp
index 6686d4a..603b3b1 100644
--- a/src/modules/PlayerBots/playerbot/strategy/generic/AttackEnemyPlayersStrategy.cpp
+++ b/src/modules/PlayerBots/playerbot/strategy/generic/AttackEnemyPlayersStrategy.cpp
@@ -5,6 +5,13 @@
 using namespace ai;
 
 void AttackEnemyPlayersStrategy::InitCombatTriggers(std::list<TriggerNode*> &triggers)
+{
+    triggers.push_back(new TriggerNode(
+        "enemy player near",
+        NextAction::array(0, new NextAction("attack enemy player", ACTION_EMERGENCY), NULL)));
+}
+
+void AttackEnemyPlayersStrategy::InitNonCombatTriggers(std::list<TriggerNode*> &triggers)
 {
     triggers.push_back(new TriggerNode(
         "enemy player near",
diff --git a/src/modules/PlayerBots/playerbot/strategy/generic/AttackEnemyPlayersStrategy.h b/src/modules/PlayerBots/playerbot/strategy/generic/AttackEnemyPlayersStrategy.h
index 3742891..d45d932 100644
--- a/src/modules/PlayerBots/playerbot/strategy/generic/AttackEnemyPlayersStrategy.h
+++ b/src/modules/PlayerBots/playerbot/strategy/generic/AttackEnemyPlayersStrategy.h
@@ -17,5 +17,17 @@ namespace ai
 #endif
     private:
         void InitCombatTriggers(std::list<TriggerNode*> &triggers) override;
+        // Also registered for non-combat (2026-07-27): an IDLE bot never
+        // transitions into BOT_STATE_COMBAT on its own just because an enemy
+        // player is standing nearby - only the reactive "was attacked" path
+        // (or an explicit attack action) does that. Since this trigger was
+        // previously only wired into the combat engine, two idle enemy bots
+        // standing next to each other in a BG never fought until a human
+        // player attacked one of them first (chicken-and-egg: needed combat
+        // state to check the trigger that starts combat). The action itself
+        // (AttackEnemyPlayerAction -> AttackAction) already transitions the
+        // bot into combat state once it actually attacks, so it's safe to
+        // fire from the non-combat engine too.
+        void InitNonCombatTriggers(std::list<TriggerNode*> &triggers) override;
     };
 }
