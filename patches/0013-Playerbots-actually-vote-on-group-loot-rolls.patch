+Roll const* Group::GetActiveRoll(ObjectGuid const& lootedTarget, uint32 itemSlot) const
+{
+    for (Roll const* roll : RollId)
+        if (roll && roll->lootedTargetGUID == lootedTarget && roll->itemSlot == itemSlot)
+            return roll;
+
+    return nullptr;
+}
