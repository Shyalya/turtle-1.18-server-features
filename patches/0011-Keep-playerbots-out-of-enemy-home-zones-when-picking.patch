-        if (areaTeam == AREATEAM_NONE && area->ZoneId)
-            if (AreaEntry const* zone = AreaEntry::GetById(area->ZoneId))
-                areaTeam = zone->Team;
-
-        return (areaTeam == AREATEAM_ALLY  && team == HORDE)
-            || (areaTeam == AREATEAM_HORDE && team == ALLIANCE);
-    }
