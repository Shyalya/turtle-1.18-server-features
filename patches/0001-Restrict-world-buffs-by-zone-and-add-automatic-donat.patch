From 8c4f156ef6869ab056d46f30941df69f4806566f Mon Sep 17 00:00:00 2001
From: shyalya <shyalya@turtle-server.local>
Date: Mon, 27 Jul 2026 11:09:36 +0100
Subject: [PATCH 1/3] Restrict world buffs by zone and add automatic donation
 points

- Spirit of Zandalar (24425) only casts while in Stranglethorn Vale.
- Warchief's Blessing (16609) only casts for Horde in Crossroads or
  Orgrimmar.
- Rallying Cry of the Dragonslayer (22888) only casts for Alliance in
  Stormwind City.
- Warning announcement fires 10 minutes ahead of the buff refresh.
- New AutoDonationPoints system: real online players (bots/Discord bridge
  excluded) earn configurable donation points (shop_coins) per hour
  online, tracked per-account so login time doesn't matter.
---
 src/game/World.cpp | 131 +++++++++++++++++++++++++++++++++++++++++++++
 src/game/World.h   |   9 ++++
 2 files changed, 140 insertions(+)

diff --git a/src/game/World.cpp b/src/game/World.cpp
index e9f65a2..0667d9d 100644
--- a/src/game/World.cpp
+++ b/src/game/World.cpp
@@ -2700,6 +2700,137 @@ void World::Update(uint32 diff)
 
     // Update AutoBroadcast
     sAutoBroadCastMgr.Update(diff);
+
+    // --- Custom: AutoWorldBuff. Verpasst echten Online-Spielern (keine Bots,
+    // kein Discord-Bruecken-Charakter) periodisch Geist von Zandalar (nur in
+    // Stranglethorn Vale), Segen des Kriegshaeuptlings (nur Horde, nur in
+    // Crossroads/Orgrimmar) und Kriegsschrei des Drachentoeters (nur Allianz,
+    // nur in Sturmwind - das Allianz-Pendant zu Segen des Kriegshaeuptlings).
+    // Intervall randomisiert zwischen Min-/MaxInterval (ms); WarningInterval
+    // (ms) vorher kommt eine Ansage. ---
+    if (sConfig.GetBoolDefault("AutoWorldBuff.Enable", false))
+    {
+        // Einmalige Vorwarnung pro Zyklus, kurz bevor die Buffs erneuert werden.
+        if (!m_worldBuffWarned && m_worldBuffWarningMs > 0 && m_worldBuffTimer <= m_worldBuffWarningMs)
+        {
+            m_worldBuffWarned = true;
+            uint32 warnMinutes = std::max<uint32>(1, m_worldBuffWarningMs / 60000);
+            SendWorldText(3 /* LANG_SYSTEMMESSAGE */,
+                string_format("In {} Minuten werden die Weltbuffs erneuert: Geist von Zandalar (in Stranglethorn) + Segen des Kriegshäuptlings (in Crossroads/Orgrimmar) + Kriegsschrei des Drachentöters (in Sturmwind)!", warnMinutes).c_str());
+        }
+
+        if (m_worldBuffTimer <= diff)
+        {
+            uint32 minMs = sConfig.GetIntDefault("AutoWorldBuff.MinInterval", 7200000);  // 2h
+            uint32 maxMs = sConfig.GetIntDefault("AutoWorldBuff.MaxInterval", 10800000); // 3h
+            if (maxMs < minMs)
+                maxMs = minMs;
+            m_worldBuffTimer = minMs + (maxMs > minMs ? urand(0, maxMs - minMs) : 0);
+
+            m_worldBuffWarningMs = sConfig.GetIntDefault("AutoWorldBuff.WarningInterval", 600000); // 10min
+            if (m_worldBuffWarningMs >= m_worldBuffTimer)
+                m_worldBuffWarningMs = m_worldBuffTimer / 2; // Sicherheitsnetz falls Warnzeit > Intervall
+            m_worldBuffWarned = false;
+
+            // Zonen-/Area-IDs aus turtle_world.area_template (2026-07-27):
+            // Stranglethorn Vale (33), Orgrimmar (1637) und Stormwind City
+            // (1519) sind selbst Top-Level-Zoneneintraege (zone_id 0), The
+            // Crossroads dagegen nur eine AREA innerhalb der Barrens (entry
+            // 380, zone_id 17) - deshalb dafuer GetAreaId() statt GetZoneId().
+            const uint32 ZONE_STRANGLETHORN_VALE = 33;
+            const uint32 ZONE_ORGRIMMAR = 1637;
+            const uint32 ZONE_STORMWIND_CITY = 1519;
+            const uint32 AREA_THE_CROSSROADS = 380;
+
+            uint32 buffedCount = 0;
+            for (SessionMap::const_iterator itr = m_sessions.begin(); itr != m_sessions.end(); ++itr)
+            {
+                WorldSession* worldBuffSession = itr->second;
+                if (!worldBuffSession)
+                    continue;
+                Player* worldBuffPlayer = worldBuffSession->GetPlayer();
+                if (!worldBuffPlayer || !worldBuffPlayer->IsInWorld())
+                    continue;
+
+                // Random-Bots laufen auf RNDBOT-Accounts (Session hat keinen
+                // Username, daher ueber die Account-ID nachschlagen). Der
+                // Discord-Bruecken-Charakter (Account DISCORD) ist ebenfalls
+                // eine echte WoW-Session, aber kein Spieler -> ausschliessen.
+                std::string worldBuffAccName;
+                sAccountMgr.GetName(worldBuffSession->GetAccountId(), worldBuffAccName);
+                if (worldBuffAccName.rfind("RNDBOT", 0) == 0 || worldBuffAccName == "DISCORD")
+                    continue;
+
+                bool worldBuffCast = false;
+                if (worldBuffPlayer->GetZoneId() == ZONE_STRANGLETHORN_VALE)
+                {
+                    worldBuffPlayer->CastSpell(worldBuffPlayer, 24425, true); // Spirit of Zandalar
+                    worldBuffCast = true;
+                }
+                if (worldBuffPlayer->GetTeam() == HORDE &&
+                    (worldBuffPlayer->GetAreaId() == AREA_THE_CROSSROADS || worldBuffPlayer->GetZoneId() == ZONE_ORGRIMMAR))
+                {
+                    worldBuffPlayer->CastSpell(worldBuffPlayer, 16609, true); // Warchief's Blessing
+                    worldBuffCast = true;
+                }
+                if (worldBuffPlayer->GetTeam() == ALLIANCE && worldBuffPlayer->GetZoneId() == ZONE_STORMWIND_CITY)
+                {
+                    worldBuffPlayer->CastSpell(worldBuffPlayer, 22888, true); // Rallying Cry of the Dragonslayer
+                    worldBuffCast = true;
+                }
+                if (worldBuffCast)
+                    ++buffedCount;
+            }
+
+            if (buffedCount)
+                SendWorldText(3 /* LANG_SYSTEMMESSAGE */, "Weltbuffs erneuert: Geist von Zandalar (in Stranglethorn) + Segen des Kriegshäuptlings (in Crossroads/Orgrimmar) + Kriegsschrei des Drachentöters (in Sturmwind)!");
+        }
+        else
+            m_worldBuffTimer -= diff;
+    }
+
+    // --- Custom: AutoDonationPoints. Vergibt echten Online-Spielern (keine
+    // Bots, kein Discord-Bruecken-Charakter) automatisch Donation-Points
+    // (shop_coins, dieselbe Tabelle/Waehrung wie ShopMgr) fuer jede volle
+    // Stunde Online-Zeit. Pro Account ein eigener Akkumulator statt eines
+    // gemeinsamen Timers, damit es keine Rolle spielt, wann genau jemand
+    // eingeloggt ist - jeder bekommt seine eigene volle Stunde. ---
+    if (sConfig.GetBoolDefault("AutoDonationPoints.Enable", false))
+    {
+        uint32 dpIntervalMs = sConfig.GetIntDefault("AutoDonationPoints.IntervalMs", 3600000); // 1h
+        uint32 dpAmount = sConfig.GetIntDefault("AutoDonationPoints.Amount", 1);
+
+        for (SessionMap::const_iterator itr = m_sessions.begin(); itr != m_sessions.end(); ++itr)
+        {
+            WorldSession* dpSession = itr->second;
+            if (!dpSession)
+                continue;
+            Player* dpPlayer = dpSession->GetPlayer();
+            if (!dpPlayer || !dpPlayer->IsInWorld())
+                continue;
+
+            std::string dpAccName;
+            sAccountMgr.GetName(dpSession->GetAccountId(), dpAccName);
+            if (dpAccName.rfind("RNDBOT", 0) == 0 || dpAccName == "DISCORD")
+                continue;
+
+            uint32 dpAccountId = dpSession->GetAccountId();
+            uint32& dpAccumMs = m_donationPointAccumulatorMs[dpAccountId];
+            dpAccumMs += diff;
+            if (dpAccumMs >= dpIntervalMs)
+            {
+                dpAccumMs -= dpIntervalMs;
+                // insert-or-add, gleiches Muster wie ShopMgr::GetBalance's
+                // "Account noch nie im Shop gewesen"-Fall.
+                LoginDatabase.PExecute(
+                    "INSERT INTO `shop_coins` (`id`, `coins`) VALUES (%u, %u) "
+                    "ON DUPLICATE KEY UPDATE `coins` = `coins` + %u",
+                    dpAccountId, dpAmount, dpAmount);
+                ChatHandler(dpPlayer).PSendSysMessage("Du hast %u Donation Point(s) fuer deine Online-Zeit erhalten!", dpAmount);
+            }
+        }
+    }
+
     // Update liste des ban si besoin
     sAccountMgr.Update(diff);
 
diff --git a/src/game/World.h b/src/game/World.h
index 0e2db52..f02331c 100644
--- a/src/game/World.h
+++ b/src/game/World.h
@@ -1325,6 +1325,15 @@ class World
         uint32 m_ShutdownMask = 0;
 
         uint32 m_MaintenanceTimeChecker = 0;
+        uint32 m_worldBuffTimer = 0; // custom: AutoWorldBuff (Onyxia-/Zandalar-Buff)
+        uint32 m_worldBuffWarningMs = 0;
+        bool m_worldBuffWarned = false;
+
+        // custom: AutoDonationPoints (2026-07-27) - pro Account akkumulierte
+        // Online-Zeit in ms seit der letzten Gutschrift, damit unterschiedliche
+        // Login-Zeitpunkte nicht auf einen gemeinsamen Takt synchronisiert
+        // werden muessen (jeder Account bekommt seine eigene volle Stunde).
+        std::unordered_map<uint32 /*accountId*/, uint32 /*accumulatedMs*/> m_donationPointAccumulatorMs;
 
         uint32 m_minChatLevel = 0;
         time_t m_startTime;
-- 
2.47.3

